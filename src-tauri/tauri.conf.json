{
  "build": {
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build",
    "devPath": "http://localhost:1420",
    "distDir": "../dist",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "TimeUp",
    "version": "0.0.2"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "minimize": true,
        "unminimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      }
    },
    "windows": [
      {
        "label": "main",
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "resizable": true,
        "title": "唤起",
        "width": 800,
        "height": 600,
        "minWidth": 280,
        "minHeight": 360,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": false,
      "targets": "all",
      "identifier": "tauri.eykettle.timeup",
      "publisher": "EyKettle",
      "copyright": "Belong to EyKettle.",
      "shortDescription": "TimeUp application.",
      "longDescription": "A simply using task manage app.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    }
  }
}
